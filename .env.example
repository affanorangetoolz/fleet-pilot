# Postgres connection string. The database must already exist.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fleet_pilot

# At least 32 random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters

# The origin the browser loads the app from.
# Dev (Vite on 5173, proxying /api to Express): http://localhost:5173
# Production build (Express serves everything):  http://localhost:3000
BETTER_AUTH_URL=http://localhost:5173

# Port the Express API listens on. Vite's dev proxy expects 3000.
PORT=3000
